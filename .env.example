# Worker: required secrets/configuration
TELEGRAM_BOT_TOKEN=replace_with_botfather_token
TELEGRAM_BOT_HANDLE=@replace_with_bot_username
ADMIN_IDS=123456789

# Persistent worker storage
DATA_DIR=./data
# DB_FILE=./data/finance.db
# SETTINGS_FILE=./data/settings.json

# Mini App static server: public worker URL in production
API_BASE_URL=http://localhost:8080
MINIAPP_PUBLIC_URL=http://localhost:8081
ENABLE_SCHEDULED_JOBS=true
# Optional comma-separated additional browser origins.
# CORS_ALLOWED_ORIGINS=https://admin.example.com
# BUILD_ID=local

# Required in production: off-site backup (S3, Cloudflare R2, Backblaze B2, etc.)
# BACKUP_REQUIRED=1
# BACKUP_S3_BUCKET=ruby-finance-backups
# BACKUP_S3_PREFIX=production/worker
# BACKUP_S3_ENDPOINT_URL=https://account-id.r2.cloudflarestorage.com
# BACKUP_S3_REGION=auto
# BACKUP_S3_ACCESS_KEY_ID=replace_with_storage_key_id
# BACKUP_S3_SECRET_ACCESS_KEY=replace_with_storage_secret
# BACKUP_S3_SESSION_TOKEN=
# BACKUP_S3_SSE=AES256
# BACKUP_LOCAL_RETENTION=7
# BACKUP_REMOTE_RETENTION_DAYS=30

# Security and monitoring
# INIT_DATA_MAX_AGE_SECONDS=21600
# RATE_LIMIT_PREAUTH_PER_MINUTE=120
# RATE_LIMIT_READ_PER_MINUTE=120
# RATE_LIMIT_WRITE_PER_MINUTE=30
# RATE_LIMIT_ADMIN_PER_MINUTE=5
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0

# Railway injects PORT automatically. Set it only for local overrides.
# PORT=8080
